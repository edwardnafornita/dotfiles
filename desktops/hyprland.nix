{
  config,
  lib,
  pkgs,
  settings,
  ...
}:
let
  cursor = config.home.pointerCursor;
  isCaelestia = settings.shell == "caelestia";
  launcher =
    if settings.shell == "noctalia" then
      "noctalia msg panel-toggle launcher"
    else
      "caelestia-shell ipc call drawers toggle launcher";
  lock =
    if settings.shell == "noctalia" then
      "noctalia msg session lock"
    else
      "caelestia-shell ipc call lock lock";
  # Caelestia's own CLI gives a nicer swappy-editing screenshot flow; Noctalia has
  # no equivalent, so it keeps the plain grim/slurp pipe.
  screenshot =
    if isCaelestia then "exec, caelestia screenshot" else "exec, grim -g \"$(slurp)\" - | wl-copy";
  # Caelestia registers global shortcuts for media/brightness so its OSD and
  # ddcutil-aware brightness logic run; Noctalia has no such globals to call.
  mediaToggle = if isCaelestia then "global, caelestia:mediaToggle" else "exec, playerctl play-pause";
  mediaNext = if isCaelestia then "global, caelestia:mediaNext" else "exec, playerctl next";
  mediaPrev = if isCaelestia then "global, caelestia:mediaPrev" else "exec, playerctl previous";
in
{
  home.pointerCursor = {
    enable = true;
    package = pkgs.bibata-cursors; # Same XCursor assets used by the existing Niri profile.
    name = "Bibata-Modern-Ice";
    size = 32;
    gtk.enable = true; # Keep GTK application cursors consistent with the compositor.
    x11.enable = true; # Cursor theme/size for XWayland applications.
  };
  gtk.enable = true; # Apply the GTK cursor settings generated by Home Manager.
  dconf.settings."org/gnome/desktop/interface" = {
    cursor-theme = cursor.name;
    cursor-size = cursor.size;
  };
  # UWSM reads this before starting Hyprland and exports it to session services.
  # An explicit asset path avoids depending on interactive shell initialization.
  xdg.configFile."uwsm/env-hyprland".text = ''
    export XCURSOR_THEME=${lib.escapeShellArg cursor.name}
    export XCURSOR_SIZE=${toString cursor.size}
    export XCURSOR_PATH="${cursor.package}/share/icons''${XCURSOR_PATH:+:$XCURSOR_PATH}"
  '';
  home.packages = with pkgs; [
    alacritty # Terminal used by the shortcuts below.
    wl-clipboard # Wayland clipboard tools.
    playerctl # Media player controls.
    brightnessctl # Brightness control for supported displays.
    grim # Wayland screenshot capture.
    slurp # Interactive screenshot region selection.
  ];
  wayland.windowManager.hyprland = {
    enable = true; # Generate compositor configuration with Home Manager.
    package = null; # Use the NixOS module's compositor and portal, avoiding version skew.
    portalPackage = null;
    systemd.enable = false; # UWSM already manages the session.
    # These settings use Hyprlang. HM 26.05 otherwise defaults to Lua and emits
    # invalid calls for legacy bind strings/$mod. Pinned Hyprland supports both.
    configType = "hyprlang";
    settings = {
      # Bibata is an XCursor theme, not a native hyprcursor theme. Use its assets
      # throughout Hyprland instead of the built-in cursor fallback.
      cursor.enable_hyprcursor = false;
      exec-once = [ "hyprctl setcursor ${lib.escapeShellArg cursor.name} ${toString cursor.size}" ];
      monitor = settings.hyprlandMonitors;
      input.kb_layout = settings.keyboardLayout;
      general = {
        gaps_in = 6;
        gaps_out = 12;
        border_size = 2;
      };
      decoration = {
        rounding = 12;
        blur = {
          enabled = true; # Required for Caelestia/Noctalia's translucent panels to render as intended.
          size = 8;
          passes = 2;
          ignore_opacity = true; # Allows opacity-blurring (upstream Caelestia decoration.lua default).
          new_optimizations = true;
          popups = true;
          input_methods = true;
        };
      };
      animations = {
        enabled = true; # Keep visual feedback while making transitions feel responsive.
        bezier = [ "quick,0.16,1,0.3,1" ]; # Fast start, gentle finish without overshoot.
        # Hyprland speed is duration in 100 ms units: smaller values finish sooner.
        animation = [
          "global,1,1.5,quick" # 150 ms for inherited transitions, including borders.
          "windows,1,1.5,quick" # 150 ms for opening/moving/resizing windows.
          "windowsOut,1,1.2,quick" # 120 ms to close a window.
          "fade,1,1.2,quick" # 120 ms opacity transitions.
          "workspaces,1,1.8,quick" # 180 ms workspace changes.
          "layers,1,1.5,quick" # 150 ms compositor transitions for panels/popups.
        ];
      };
      "$mod" = "SUPER";
      # Slurp's region-picker, used by the Print bind either way. Hyprland 0.55's
      # layerrule syntax requires the explicit match:namespace field name.
      layerrule = [ "animation fade, match:namespace selection" ];
      bind = [
        "$mod, T, exec, alacritty"
        "$mod, E, exec, thunar"
        "$mod, B, exec, ${settings.browser}"
        "$mod, Q, killactive,"
        "$mod, F, fullscreen,"
        "$mod, Space, exec, ${launcher}"
        "$mod ALT, L, exec, ${lock}"
        "$mod SHIFT, E, exec, uwsm stop"
        "$mod, left, movefocus, l"
        "$mod, right, movefocus, r"
        "$mod, up, movefocus, u"
        "$mod, down, movefocus, d"
        "$mod ALT, Space, togglefloating,"
        ", Print, ${screenshot}"
      ]
      # Caelestia reserves $mod+V for its clipboard history; Noctalia keeps the
      # original floating-toggle key since it has no clipboard bind to free it for.
      ++ lib.optional (!isCaelestia) "$mod, V, togglefloating,"
      ++ lib.concatMap (n: [
        "$mod, ${toString n}, workspace, ${toString n}"
        "$mod SHIFT, ${toString n}, movetoworkspace, ${toString n}"
      ]) (lib.range 1 9);
      bindel = [
        ", XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"
        ", XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
      ]
      ++ lib.optionals (!isCaelestia) [
        ", XF86MonBrightnessUp, exec, brightnessctl set +5%"
        ", XF86MonBrightnessDown, exec, brightnessctl set 5%-"
      ];
      bindl = [
        ", XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
        ", XF86AudioPlay, ${mediaToggle}"
        ", XF86AudioNext, ${mediaNext}"
        ", XF86AudioPrev, ${mediaPrev}"
      ]
      # Caelestia's brightness globals aren't flagged repeating upstream (ddcutil
      # calls are comparatively slow); brightnessctl's bindel equivalent was.
      ++ lib.optionals isCaelestia [
        ", XF86MonBrightnessUp, global, caelestia:brightnessUp"
        ", XF86MonBrightnessDown, global, caelestia:brightnessDown"
      ];
      bindm = [
        "$mod, mouse:272, movewindow"
        "$mod, mouse:273, resizewindow"
      ];
    };
  };
}
